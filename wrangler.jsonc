{
  // Home Tutor: one Worker serves the PWA (static assets from the Cloudflare edge) and the API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-tutor",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-tutor",
      // Filled in by scripts/deploy.sh after `wrangler d1 create home-tutor`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "api/migrations"
    }
  ],
  // Live classroom rooms (D-059). Wrangler applies the Durable Object migration on deploy;
  // add a new tag (v2, ...) for any later class change, never edit v1.
  "durable_objects": {
    "bindings": [{ "name": "CLASSROOM", "class_name": "ClassroomRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClassroomRoom"] }],
  "vars": {
    "AI_TUTOR_ENABLED": "false",
    // "unlocked" only for the review edition worker (scripts/deploy.sh unlocked rewrites it).
    "EDITION": "standard"
  },
  "observability": { "enabled": false }
}
