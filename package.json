{
  "name": "home-tutor",
  "version": "0.1.0",
  "private": true,
  "main": "index",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "content": "tsx scripts/build-content.ts",
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "npm run validate && npm run content && expo export -p web && tsx scripts/postbuild-pwa.ts",
    "e2e": "playwright test",
    "serve": "tsx scripts/serve-dist.ts",
    "check:bundle": "tsx scripts/check-bundle.ts"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.7",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
